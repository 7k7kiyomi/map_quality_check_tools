<?xml version="1.0" encoding="UTF-8" ?>
<check_list>
    <scale>
	<!--与比例尺无关的检查项比例尺处value可以为空-->
		<value></value>
		<check_item>
			<id>200</id>
			<name>注记匹配</name>
			<rule>
				<name>属性项</name>
				<description>GDB数据分层属性</description>
				<value>LEVEL</value>
			</rule>
			<rule>
				<name>属性值</name>
        		<description>GDB数据分层属性值</description>
        		<value>三级</value>
			</rule>
			<rule>
				<name>标注字段</name>
        		<description>GDB数据对应注记内容的属性</description>
        		<value>NAMES</value>
			</rule>
		</check_item>
		<!--质检项_字体，按照指标文件中的标准写-->
		<check_item>
			<id>201</id>
			<name>字体</name>
			<rule>
				<name>字体名</name>
				<description>字体中文名</description>
				<value>方正细等线简体</value>
			</rule>
		</check_item>

		<!--质检项_字大，按照指标文件中的标准写-->
        <check_item>
            <id>202</id>
            <name>字大</name>
            <rule>
                <name>最小字大</name>
                <description>字体大小最小值</description>
                <unit>毫米</unit>
                <value>3.5</value>
            </rule>
            <rule>
                <name>最大字大</name>
                <description>字体大小最大值</description>
                <unit>毫米</unit>
                <value>4</value>
            </rule>
        </check_item>

		<!--质检项_颜色，按照指标文件中的标准写-->
		<check_item>
			<id>203</id>
			<name>字体颜色</name>
			<rule>
				<name>颜色代码</name>
				<description>字体颜色代码</description>
				<value>K100</value>
			</rule>
		</check_item>
		<check_item>
			<id>204</id>
			<name>字距</name>
			<rule>
				<name>字体最小间距</name>
				<description>单个字体间最小允许间距</description>
				<unit>毫米</unit>
				<value>1</value>
			</rule>
			<rule>
				<name>字体最大间距</name>
				<description>单个字体间最大允许间距</description>
				<unit>毫米</unit>
				<value>5</value>
			</rule>
			<rule>
		        <name>检查等间距</name>
		        <description>是否检查同一散列注记组内相邻字符排列的等间距性</description>
		        <value>true</value>
		    </rule>
		    <rule>
		        <name>等间距允许偏差</name>
		        <description>相邻字符中心距相对于组内平均中心距的最大允许相对偏差，0.10表示10%</description>
		        <value>0.10</value>
		    </rule>
		</check_item>
		<check_item>
			<id>207</id>
			<name>线要素注记间距</name>
			<rule>
				<name>注记最小间距</name>
				<description>注记组间最小允许间距</description>
				<unit>毫米</unit>
				<value>3</value>
			</rule>
			<rule>
				<name>注记最大间距</name>
				<description>注记组间最大允许间距</description>
				<unit>毫米</unit>
				<value>10</value>
			</rule>
		</check_item>
		<check_item>
			<id>210</id>
			<name>符号注记匹配</name>
			<rule>
				<name>允许无注记</name>
				<description>是否允许符号没有对应的注记</description>
				<value>false</value>
			</rule>
			<!--允许无符号 例如永登县的"地理名称"图层图上只表示注记不表示点符号-->
			<rule>
				<name>允许无符号</name>
				<description>是否允许注记没有对应的符号</description>
				<value>false</value>
			</rule>
			<rule>
				<name>最小间距</name>
				<description>匹配的符号与注记之间的最小允许间距</description>
				<unit>毫米</unit>
				<value>2</value>
			</rule>
			<rule>
				<name>最大间距</name>
				<description>匹配的符号与注记之间的最大允许间距</description>
				<unit>毫米</unit>
				<value>5</value>
			</rule>
		</check_item>

	</scale>
</check_list>