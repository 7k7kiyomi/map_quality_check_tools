<?xml version="1.0" encoding="UTF-8" ?>
<check_list>
    <scale>
	<!--与比例尺无关的检查项比例尺处value可以为空-->
		<value></value>
		<check_item>
			<id>200</id>
			<name>注记匹配</name>
			<rule>
				<name>属性项</name>
				<description>GDB数据分层属性</description>
				<value></value>
			</rule>
			<rule>
				<name>属性值</name>
        		<description>GDB数据分层属性值</description>
        		<value></value>
			</rule>
			<rule>
				<name>标注字段</name>
        		<description>GDB数据对应注记内容的属性</description>
        		<value>NAME</value>
			</rule>
		</check_item>
		<!--质检项_字体，按照指标文件中的标准写-->
		<check_item>
			<id>201</id>
			<name>字体</name>
			<rule>
				<name>字体名</name>
				<description>字体中文名</description>
				<value>方正隶书简体;方正隶书简体;方正隶书简体</value>
			</rule>
			<rule>
				<name>关联主区</name>
				<description>关联主区图层（标准图层）</description>
				<unit></unit>
				<value>行政区划面普色</value>
			</rule>
			<rule>
				<name>关联省内</name>
				<description>关联省内 GDB 图层</description>
				<unit></unit>
				<value>BOUA2</value>
			</rule>
			<rule>
				<name>省内筛选字段</name>
        		<description>GDB数据属性字段</description>
        		<value>NAME</value>
			</rule>
			<rule>
				<name>省内筛选值</name>
        		<description>GDB数据中作为省内的值</description>
        		<value>甘肃省</value>
			</rule>
		</check_item>

		<!--质检项_字大，按照指标文件中的标准写-->
		<check_item>
			<id>202</id>
			<name>字大</name>
			<rule>
				<name>字体大小</name>
				<description>字体大小，表面注记字体大小依次为主区、外区省内、外区省外</description>
				<unit>毫米</unit>
				<value>9;8;7</value>
			</rule>
			<rule>
				<name>关联主区</name>
				<description>关联主区图层（标准图层）</description>
				<unit></unit>
				<value>行政区划面普色</value>
			</rule>
			<rule>
				<name>关联省内</name>
				<description>关联省内 GDB 图层</description>
				<unit></unit>
				<value>BOUA2</value>
			</rule>
			<rule>
				<name>省内筛选字段</name>
        		<description>GDB数据属性字段</description>
        		<value>NAME</value>
			</rule>
			<rule>
				<name>省内筛选值</name>
        		<description>GDB数据中作为省内的值</description>
        		<value>甘肃省</value>
			</rule>
		</check_item>

		<!--质检项_颜色，按照指标文件中的标准写-->
		<check_item>
			<id>203</id>
			<name>字体颜色</name>
			<rule>
				<name>颜色代码</name>
				<description>字体颜色代码</description>
				<value>K100;K100;K100</value>
			</rule>
			<rule>
				<name>关联主区</name>
				<description>关联主区图层（标准图层）</description>
				<unit></unit>
				<value>行政区划面普色</value>
			</rule>
			<rule>
				<name>关联省内</name>
				<description>关联省内 GDB 图层</description>
				<unit></unit>
				<value>BOUA2</value>
			</rule>
			<rule>
				<name>省内筛选字段</name>
        		<description>GDB数据属性字段</description>
        		<value>NAME</value>
			</rule>
			<rule>
				<name>省内筛选值</name>
        		<description>GDB数据中作为省内的值</description>
        		<value>甘肃省</value>
			</rule>
		</check_item>
		<check_item>
			<id>204</id>
			<name>字距</name>
			<rule>
				<name>字体最小间距</name>
				<description>单个字体间最小允许间距</description>
				<unit>毫米</unit>
				<value>1</value>
			</rule>
			<rule>
				<name>字体最大间距</name>
				<description>单个字体间最大允许间距</description>
				<unit>毫米</unit>
				<value>5</value>
			</rule>
		</check_item>

        <!-- 质检项_面要素字距与等间距检查（208等间距），此处等间距注记距离标注不检查，图层只检查单个字体距离-->
		<check_item>
			<id>208</id>
			<name>面要素等间距标注</name>
			<rule>
				<name>最小标注数量</name>
				<description>少于该数量则不执行等间距检查</description>
				<value>3</value>
			</rule>
			<rule>
				<name>允许偏差</name>
				<description>相对于该要素平均间距的允许偏差（比例，例如0.2表示±20%）</description>
				<unit>ratio</unit>
				<value>0.2</value>
			</rule>
		</check_item>

		<!-- 质检项_符号注记匹配检查-->
	    <check_item>
			<id>210</id>
			<name>符号注记匹配</name>
        <!--允许无符号 例如永登县的"地理名称"图层图上只表示注记不表示点符号-->
            <rule>
				<name>允许无符号</name>
                <description>是否允许注记没有对应的符号</description>
                <value>false</value>
            </rule>
            <rule>
				<name>最小间距</name>
                <description>匹配的符号与注记之间的最小允许间距</description>
                <unit>毫米</unit>
                <value>2</value>
            </rule>
            <rule>
				<name>最大间距</name>
                <description>匹配的符号与注记之间的最大允许间距</description>
                <unit>毫米</unit>
				<value>5</value>
			</rule>
        </check_item>
	</scale>
</check_list>