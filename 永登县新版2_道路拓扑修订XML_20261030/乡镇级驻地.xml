<?xml version="1.0" encoding="UTF-8"?>
<!--乡镇驻地图层质检方案-->
<check_list>
    <scale>
        <value></value>
        <!-- 质检项1：要素层缺失检查（ID:101） -->
        <check_item>
            <name>要素层缺失检查</name>
            <id>101</id>
            <severity>高</severity>
            <rule>
                <name>缓冲区半径</name>
                <description>要素层缺失检查中库体数据缓冲区半径</description>
                <value>3</value>
                <unit>mm</unit>
            </rule>
        </check_item>
        <!-- 质检项2：要素缺失检查（ID:102） -->
        <check_item>
            <name>要素缺失检查</name>
            <id>102</id>
            <severity>高</severity>
            <rule>
                <name>属性项</name>
                <description>库体数据中区分各级驻地的属性项</description>
                <value>CLASID</value>
                <unit></unit>
            </rule>
            <rule>
                <name>属性值</name>
                <description>属性项对应乡镇级政府驻地的属性值</description>
                <value>311105</value>
                <unit></unit>
            </rule>
            <rule>
                <name>缓冲区半径</name>
                <description>建立缓冲区半径</description>
                <value>3</value>
                <unit>mm</unit>
            </rule>
        </check_item>
        <!-- 质检项3：要素错绘检查（ID:103） -->
        <check_item>
            <name>要素错绘检查</name>
            <id>103</id>
            <severity>高</severity>
            <rule>
                <name>点要素缓冲区半径</name>
                <description>对库体BOUP6层市级驻地点位建立缓冲区，解析后点位必须落在缓冲区内</description>
                <value>0.4</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项4：标准图例匹配检查（ID:304） -->
        <check_item>
            <name>标准图例匹配检查</name>
            <id>304</id>
            <severity>高</severity>
            <rule>
                <name>标准图例匹配检查</name>
                <description>图层与标准图例是否一致</description>
            </rule>
        </check_item>
    </scale>
</check_list>  