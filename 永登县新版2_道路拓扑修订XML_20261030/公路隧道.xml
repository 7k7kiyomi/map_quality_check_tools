<?xml version="1.0" encoding="UTF-8"?>
<!--公路隧道图层质检方案-->
<check_list>
    <scale>
        <value></value>
        <!-- 质检项1：要素层缺失检查（ID:101） -->
        <check_item>
            <name>要素层缺失检查</name>
            <id>101</id>
            <severity>高</severity>
            <rule>
                <name>缓冲区半径</name>
                <description>要素层缺失检查中库体数据缓冲区半径</description>
                <value>3</value>
                <unit>mm</unit>
            </rule>
        </check_item>
        <!-- 质检项2：要素缺失检查（ID:102） -->
        <check_item>
            <name>要素缺失检查</name>
            <id>102</id>
            <severity>高</severity>
            <rule>
                <name>属性项</name>
                <description>库体数据中区分公路隧道的属性项</description>
                <value>CLASID</value>
            </rule>
            <rule>
                <name>属性值</name>
                <description>属性项对公路隧道的属性值</description>
                <value>450602</value>
            </rule>
            <rule>
                <name>缓冲区半径</name>
                <description>建立缓冲区半径</description>
                <value>3</value>
                <unit>mm</unit>
            </rule>
            <rule>
                <name>最小长度</name>
                <description>选择表示的最小长度</description>
                <value>1</value>
                <unit>cm</unit>
            </rule>
        </check_item>
        <!-- 质检项3：要素错绘检查（ID:103） -->
        <check_item>
            <name>要素错绘检查</name>
            <id>103</id>
            <severity>中</severity>
            <rule>
                <name>缓冲区半径</name>
                <description>库体数据缓冲区半径</description>
                <value>3</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项4：绝对偏移检查（ID:104） -->
        <check_item>
            <name>绝对偏移检查</name>
            <id>104</id>
            <severity>中</severity>
            <rule>
                <name>缓冲区半径</name>
                <description>库体数据缓冲区半径</description>
                <value>4.35</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项5：线要素拓扑检查（ID:112） -->
        <check_item>
            <name>线要素拓扑检查</name>
            <id>112</id>
            <severity>中</severity>
            <rule>
                <name>关联图层</name>
                <description>水系、道路线要素与那些图层关联，检查方向性</description>
                <value>高速公路、快速路、国道、省道、县道、乡道、专用道、连接道、村道、公路隧道、自然村、行政村、乡镇级驻地、县级驻地、街区面</value>
            </rule>
            <rule>
                <name>悬挂线容差</name>
                <description>悬挂线检查的容差距离</description>
                <value>0.2</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>最小线段长度</name>
                <description>线要素的最小有效长度</description>
                <value>0.034</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>孤立距离</name>
                <description>判定线要素孤立的距离阈值</description>
                <value>0.2</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>连通性容差</name>
                <description>线要素连通性检查的容差</description>
                <value>0.2</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>网络缓冲距离</name>
                <description>网络连通性分析的缓冲距离</description>
                <value>0.2</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>连通性阈值</name>
                <description>网络连通性的百分比阈值</description>
                <value>95</value>
                <unit>百分比</unit>
            </rule>
            <rule>
                <name>库体数据匹配容差</name>
                <description>与库体数据进行空间关系对比的容差距离</description>
                <value>0.006897</value>
                <unit>毫米</unit>
            </rule>
        
            <rule>
                <name>道路连接缓冲距离</name>
                <description>成果道路端点与其他成果道路的图上允许间隙，公路隧道参与构网</description>
                <value>0.2</value>
                <unit>毫米</unit>
            </rule>

            <rule>
                <name>居民点缓冲距离</name>
                <description>对每个端点独立判断合理居民点终止，不豁免另一个端点</description>
                <value>1</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项6：标准图例匹配检查（ID:304） -->
        <check_item>
            <name>标准图例匹配检查</name>
            <id>304</id>
            <severity>高</severity>
            <rule>
                <name>标准图例匹配检查</name>
                <description>图层与标准图例是否一致</description>
                <value></value>
            </rule>
        </check_item>
    </scale>
</check_list>
