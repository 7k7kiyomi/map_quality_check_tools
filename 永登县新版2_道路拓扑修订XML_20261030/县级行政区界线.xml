<?xml version="1.0" encoding="UTF-8"?>
<!--县级行政区界线图层质检方案-->
<check_list>
    <scale>
        <value></value>
        <!-- 质检项1：要素层缺失检查（ID:101） -->
        <check_item>
            <name>要素层缺失检查</name>
            <id>101</id>
            <severity>高</severity>
            <rule>
                <name>缓冲区半径</name>
                <description>要素层缺失检查中库体数据缓冲区半径</description>
                <value>3</value>
                <unit>mm</unit>
            </rule>
        </check_item>
        <!-- 质检项2：要素缺失检查（ID:102） -->
        <check_item>
            <name>要素缺失检查</name>
            <id>102</id>
            <severity>高</severity>
            <rule>
                <name>属性项</name>
                <description>库体数据中区分县级行政区界线的属性项</description>
                <value>CLASID</value>
            </rule>
            <rule>
                <name>属性值</name>
                <description>属性项对县级行政区界线的属性值</description>
                <value>650201</value>
            </rule>
            <rule>
                <name>缓冲区半径</name>
                <description>建立缓冲区半径</description>
                <value>3</value>
                <unit>mm</unit>
            </rule>
        </check_item>
        <!-- 质检项3：要素错绘检查（ID:103） -->
        <check_item>
            <name>要素错绘检查</name>
            <id>103</id>
            <severity>高</severity>
            <rule>
                <name>缓冲区半径</name>
                <description>库体数据缓冲区半径</description>
                <value>3</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项4：绝对偏移检查（ID:104） -->
        <check_item>
            <name>绝对偏移检查</name>
            <id>104</id>
            <severity>高</severity>
            <rule>
                <name>缓冲区半径</name>
                <description>库体数据缓冲区半径</description>
                <value>4.35</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项5：最小弯曲阈值控制（ID:106） -->
        <check_item>
            <name>最小弯曲阈值控制</name>
            <id>106</id>
            <severity>中</severity>
            <rule>
                <name>斜率判断阈值</name>
                <description>斜率变化角度（转折角），超过则认为是拐点</description>
                <value>10</value>
                <unit>度</unit>
            </rule>
            <rule>
                <name>最小弯曲阈值</name>
                <description>小于最小弯曲阈值的弯曲在综合时应被简化</description>
                <value>4</value>
                <unit>平方毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项6：特征点限差控制（ID:107） -->
        <check_item>
            <name>特征点限差控制</name>
            <id>107</id>
            <severity>中</severity>
            <rule>
                <name>特征点限差控制阈值</name>
                <description>库体数据点和综合后数据点间可接受的距离</description>
                <value>4</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项7：光滑度阈值控制（ID:108） -->
        <check_item>
            <name>光滑度阈值控制</name>
            <id>108</id>
            <severity>低</severity>
            <rule>
                <name>光滑度阈值</name>
                <description>综合后图上光滑度阈值</description>
                <value>0.36</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项8：直角化角度阈值控制（ID:109） -->
        <check_item>
            <name>直角化角度阈值控制</name>
            <id>109</id>
            <severity>低</severity>
            <rule>
                <name>直角化角度下限</name>
                <description>直角化特征点角度范围的下限值</description>
                <value>80</value>
                <unit>度</unit>
            </rule>
            <rule>
                <name>直角化角度上限</name>
                <description>直角化特征点角度范围的上限值</description>
                <value>100</value>
                <unit>度</unit>
            </rule>
            <rule>
                <name>库体数据匹配容差</name>
                <description>与库体数据进行要素匹配的距离容差</description>
                <value>10.35</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>几何相似度阈值</name>
                <description>判断要素匹配的几何相似度最小阈值</description>
                <value>0.3</value>
                <unit>比例</unit>
            </rule>
            <rule>
                <name>转折点检测容差</name>
                <description>检测线要素转折点的角度变化容差</description>
                <value>20</value>
                <unit>度</unit>
            </rule>
            <rule>
                <name>转折点匹配容差</name>
                <description>用于点级对应/吸附的距离容差</description>
                <value>6.9</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>最小线段长度</name>
                <description>参与直角化检查的最小线段长度</description>
                <value>10</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项9：削尖角度阈值控制（ID:110） -->
        <check_item>
            <name>削尖角度阈值控制</name>
            <id>110</id>
            <severity>中</severity>
            <rule>
                <name>削尖角度阈值</name>
                <description>检测线状、面状要素中小于该值的尖角需要剔除</description>
                <value>20</value>
                <unit>度</unit>
            </rule>
        </check_item>
        <!-- 质检项10：境界线越级检查（ID:114） -->
        <check_item>
            <name>境界线越级检查</name>
            <id>114</id>
            <severity>高</severity>
            <rule>
                <name>线宽属性项</name>
                <description>解析后的县级行政区界线线宽属性项</description>
                <value>stroke_wid</value>
            </rule>
            <rule>
                <name>颜色属性项</name>
                <description>解析后的县级行政区界线颜色属性项</description>
                <value>stroke_col</value>
            </rule>
            <rule>
                <name>线宽</name>
                <description>县级行政区界线标准线宽</description>
                <value>0.4</value>
                <unit>mm</unit>
            </rule>
            <rule>
                <name>颜色</name>
                <description>县级行政区界线标准颜色</description>
                <value>k100</value>
            </rule>
        </check_item>
        <!-- 质检项11：行政区划面套合检查（ID:115） -->
        <check_item>
            <name>行政区划面套合检查</name>
            <id>115</id>
            <severity>高</severity>
            <rule>
                <name>关联图层</name>
                <description>行政区划面套合检查所需要的关联图层</description>
                <value>行政区划面普色</value>
            </rule>
            <rule>
                <name>容差阈值</name>
                <description>行政区面与境界线的最小容差阈值</description>
                <value>0.2</value>
                <unit>mm</unit>
            </rule>
            <rule>
                <name>候选搜索区半径</name>
                <description>筛选有效境界线和以有效境界线搜索附近行政区边界的实际搜索半径</description>
                <value>1.4</value>
                <unit>mm</unit>
            </rule>
        </check_item>
        <!-- 质检项12：境界线缺失和跳绘检查（ID:116） -->
        <check_item>
            <name>境界线缺失和跳绘检查</name>
            <id>116</id>
            <severity>中</severity>
            <rule>
                <name>关联图层</name>
                <description>境界线跳绘检查所需的其他关联图层</description>
                <value>一级河流、二级河流、三级河流、四级河流、五级河流、六级河流、等外河流、时令河、河流面</value>
            </rule>
            <rule>
                <name>重叠长度</name>
                <description>GDB数据中线状要素与行政区边界的重叠长度</description>
                <value>0.5</value>
                <unit>cm</unit>
            </rule>
            <rule>
                <name>重叠拓扑容差</name>
                <description>GDB数据中线状要素与行政区边界的重叠拓扑容差</description>
                <value>0.1</value>
                <unit>mm</unit>
            </rule>
            <rule>
                <name>匹配缓冲区半径</name>
                <description>GDB线状要素与解析后线状要素匹配缓冲区的半径</description>
                <value>2</value>
                <unit>mm</unit>
            </rule>
            <rule>
                <name>搜索缓冲区半径</name>
                <description>匹配后的线状要素搜索沿其分布的境界线缓冲区半径</description>
                <value>2</value>
                <unit>mm</unit>
            </rule>
            <rule>
                <name>绘制距离</name>
                <description>以线状物为界的境界线沿线状物两侧的绘制距离</description>
                <value>0.2</value>
                <unit>mm</unit>
            </rule>
            <rule>
                <name>绘制距离容差</name>
                <description>成果境界线相对规定跳绘距离的允许偏差</description>
                <value>10</value>
                <unit>%</unit>
            </rule>
            <rule>
                <name>走向夹角阈值</name>
                <description>成果境界线与匹配后的解析线状要素局部走向的最大允许夹角</description>
                <value>30</value>
                <unit>degree</unit>
            </rule>
            <rule>
                <name>属性项</name>
                <description>库体数据中区分县级行政区界线的属性项</description>
                <value>CLASID</value>
            </rule>
            <rule>
                <name>属性值</name>
                <description>属性项对县级行政区界线的属性值</description>
                <value>650201</value>
            </rule>
            <rule>
                <name>缓冲区半径</name>
                <description>建立缓冲区半径</description>
                <value>3</value>
                <unit>mm</unit>
            </rule>
            <rule>
                <name>境界线符号长度</name>
                <description>县级境界线的符号长度</description>
                <value>8</value>
                <unit>mm</unit>
            </rule>
            <rule>
                <name>最大跳绘步长系数</name>
                <description>最大跳绘步长与境界线符号长度的倍数关系</description>
                <value>5</value>
                <unit>倍</unit>
            </rule>
        </check_item>
        <!-- 质检项13：标准图例匹配检查（ID:304） -->
        <check_item>
            <name>标准图例匹配检查</name>
            <id>304</id>
            <severity>高</severity>
            <rule>
                <name>标准图例匹配检查</name>
                <description>图层与标准图例是否一致</description>
                <value></value>
            </rule>
        </check_item>
    </scale>
</check_list>
