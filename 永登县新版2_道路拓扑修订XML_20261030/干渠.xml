<?xml version="1.0" encoding="UTF-8"?>
<!--干渠图层质检方案-->
<check_list>
    <scale>
        <value></value>
        <!-- 质检项1：要素层缺失检查（ID:101） -->
        <check_item>
            <name>要素层缺失检查</name>
            <id>101</id>
            <severity>高</severity>
            <rule>
                <name>缓冲区半径</name>
                <description>要素层缺失检查中库体数据缓冲区半径</description>
                <value>3</value>
                <unit>mm</unit>
            </rule>
        </check_item>
        <!-- 质检项2：要素缺失检查（ID:102） -->
        <check_item>
            <name>要素缺失检查</name>
            <id>102</id>
            <severity>高</severity>
            <rule>
                <name>属性项</name>
                <description>库体数据中区分干渠的属性项</description>
                <value>CLASID</value>
            </rule>
            <rule>
                <name>属性值</name>
                <description>属性项对干渠的属性值</description>
                <value>220200</value>
            </rule>
            <rule>
                <name>缓冲区半径</name>
                <description>建立缓冲区半径</description>
                <value>3</value>
                <unit>mm</unit>
            </rule>
        </check_item>
        <!-- 质检项3：要素错绘检查（ID:103） -->
        <check_item>
            <name>要素错绘检查</name>
            <id>103</id>
            <severity>中</severity>
            <rule>
                <name>缓冲区半径</name>
                <description>库体数据缓冲区半径</description>
                <value>3</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项4：绝对偏移检查（ID:104） -->
        <check_item>
            <name>绝对偏移检查</name>
            <id>104</id>
            <severity>中</severity>
            <rule>
                <name>缓冲区半径</name>
                <description>库体数据缓冲区半径</description>
                <value>4.35</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项5：几何走向异常检查（ID:105） -->
        <check_item>
            <name>几何走向异常检查</name>
            <id>105</id>
            <severity>中</severity>
            <rule>
                <name>库体数据匹配容差</name>
                <description>与库体数据进行匹配时的距离容差</description>
                <value>0.069</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>最小河流长度</name>
                <description>参与检查的最小河流长度</description>
                <value>0.034</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>交叉点检测容差</name>
                <description>检测河流交叉点的容差距离</description>
                <value>0.003</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>悬挂线检测容差</name>
                <description>检测悬挂河流的容差距离</description>
                <value>0.003</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项6：最小弯曲阈值控制（ID:106） -->
        <check_item>
            <name>最小弯曲阈值控制</name>
            <id>106</id>
            <severity>中</severity>
            <rule>
                <name>斜率判断阈值</name>
                <description>斜率变化角度（转折角），超过则认为是拐点</description>
                <value>10</value>
                <unit>度</unit>
            </rule>
            <rule>
                <name>最小弯曲阈值</name>
                <description>小于最小弯曲阈值的弯曲在综合时应被简化</description>
                <value>4</value>
                <unit>平方毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项7：特征点限差控制（ID:107） -->
        <check_item>
            <name>特征点限差控制</name>
            <id>107</id>
            <severity>高</severity>
            <rule>
                <name>特征点限差控制阈值</name>
                <description>库体数据点和综合后数据点间可接受的距离</description>
                <value>4</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项8：光滑度阈值控制（ID:108） -->
        <check_item>
            <name>光滑度阈值控制</name>
            <id>108</id>
            <severity>低</severity>
            <rule>
                <name>光滑度阈值</name>
                <description>综合后图上光滑度阈值</description>
                <value>0.36</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项9：直角化角度阈值控制（ID:109） -->
        <check_item>
            <name>直角化角度阈值控制</name>
            <id>109</id>
            <severity>低</severity>
            <rule>
                <name>直角化角度下限</name>
                <description>直角化特征点角度范围的下限值</description>
                <value>60</value>
                <unit>度</unit>
            </rule>
            <rule>
                <name>直角化角度上限</name>
                <description>直角化特征点角度范围的上限值</description>
                <value>120</value>
                <unit>度</unit>
            </rule>
            <rule>
                <name>库体数据匹配容差</name>
                <description>与库体数据进行要素匹配的距离容差</description>
                <value>10.35</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>几何相似度阈值</name>
                <description>判断要素匹配的几何相似度最小阈值</description>
                <value>0.3</value>
                <unit>比例</unit>
            </rule>
            <rule>
                <name>转折点检测容差</name>
                <description>检测线要素转折点的角度变化容差</description>
                <value>20</value>
                <unit>度</unit>
            </rule>
            <rule>
                <name>转折点匹配容差</name>
                <description>用于点级对应/吸附的距离容差</description>
                <value>6.9</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>最小线段长度</name>
                <description>参与直角化检查的最小线段长度</description>
                <value>10</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项10：削尖角度阈值控制（ID:110） -->
        <check_item>
            <name>削尖角度阈值控制</name>
            <id>110</id>
            <severity>低</severity>
            <rule>
                <name>削尖角度阈值</name>
                <description>检测线状、面状要素中小于该值的尖角需要剔除</description>
                <value>20</value>
                <unit>度</unit>
            </rule>
            <rule>
                <name>启用源数据属性筛选</name>
                <description>当解析图层中包含多种类别的要素，而本次只需检查其中一部分时，填写true，并设置下方属性筛选条件。例如，“水系”图层同时包含三级河流和六级河流，本次只检查六级河流时，应开启此项，根据源数据中的分类属性确定检查对象。如果传入解析图层中的全部要素都需要检查，填写false，无需设置属性筛选条件。</description>
                <value>True</value>
            </rule>
            <rule>
                <name>属性筛选字段</name>
                <description>填写GDB或源数据的实际字段名，仅开启筛选时需要。多个条件继续增加属性筛选字段2、属性筛选方式2、属性筛选值2，条件之间为并且。</description>
                <value>TYPE</value>
            </rule>
            <rule>
                <name>属性筛选方式</name>
                <description>等于或包含。筛选值为空或不为空时，本项留空或等于。</description>
                <value>等于</value>
            </rule>
            <rule>
                <name>属性筛选值</name>
                <description>填写对应类别的真实属性值；同一条件可用英文或中文分号填写多个值，命中任意一项即可。支持为空、不为空。不开启筛选时无需填写。</description>
                <value>干渠</value>
            </rule>
        </check_item>
        <!-- 质检项11：线要素拓扑检查（ID:112） -->
        <check_item>
            <name>线要素拓扑检查</name>
            <id>112</id>
            <severity>中</severity>
            <rule>
                <name>关联图层</name>
                <description>水系、道路线要素与那些图层关联，检查方向性</description>
                <value>湖泊水库面、河流面、水库、拦河坝、井、泉</value>
            </rule>
            <rule>
                <name>悬挂线容差</name>
                <description>悬挂线检查的容差距离</description>
                <value>0.003</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>最小线段长度</name>
                <description>线要素的最小有效长度</description>
                <value>0.034</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>孤立距离</name>
                <description>判定线要素孤立的距离阈值</description>
                <value>0.069</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>连通性容差</name>
                <description>线要素连通性检查的容差</description>
                <value>0.034</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>网络缓冲距离</name>
                <description>网络连通性分析的缓冲距离</description>
                <value>0.014</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>连通性阈值</name>
                <description>网络连通性的百分比阈值</description>
                <value>95</value>
                <unit>百分比</unit>
            </rule>
            <rule>
                <name>水系要素连接容差</name>
                <description>河流与水系面、水库、拦水坝、井、泉等要素连接判断的容差距离</description>
                <value>0.003</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>河网重叠检查容差</name>
                <description>水系线与水系面等要素重叠检查的容差距离</description>
                <value>0.00069</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>河网交叉检查容差</name>
                <description>水系线与其他要素交叉检查的容差距离</description>
                <value>0.001379</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>河网超出检查容差</name>
                <description>水系线超出水系面等要素边界的容差距离</description>
                <value>0.002069</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>库体数据匹配容差</name>
                <description>与库体数据进行空间关系对比的容差距离</description>
                <value>0.006897</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项12：标准图例匹配检查（ID:304） -->
        <check_item>
            <name>标准图例匹配检查</name>
            <id>304</id>
            <severity>高</severity>
            <rule>
                <name>标准图例匹配检查</name>
                <description>图层与标准图例是否一致</description>
                <value></value>
            </rule>
        </check_item>
    </scale>
</check_list>
