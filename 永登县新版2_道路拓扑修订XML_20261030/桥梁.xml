<?xml version="1.0" encoding="UTF-8"?>
<!--桥梁图层质检方案-->
<check_list>
    <scale>
        <value></value>
        <!-- 质检项1：关系检查（ID:113） -->
        <check_item>
            <name>关系检查</name>
            <id>113</id>
            <severity>高</severity>
            <rule>
                <name>具体项</name>
                <description>关系检查的具体项</description>
                <value>桥梁位置检查</value>
            </rule>
            <rule>
                <name>桥梁位置检查关联的道路图层</name>
                <description>桥梁位置检查需要关联的道路图层，检查桥梁是否与其相交</description>
                <value>在建高速铁路;高速铁路;普通铁路;在建高速公路;高速公路;快速路;国道;省道;县道;乡道;专用公路;连接道;村道;铁路隧道;公路隧道</value>
            </rule>
            <rule>
                <name>桥梁位置检查关联的河流图层</name>
                <description>桥梁位置检查需要关联的水系图层，检查桥梁是否与其相交</description>
                <value>河流面</value>
            </rule>
        </check_item>
        <!-- 质检项2：符号方向性检查（ID:209） -->
        <check_item>
            <name>符号方向性检查</name>
            <id>209</id>
            <severity>高</severity>
            <rule>
                <name>检查类型</name>
                <value>平行</value>
            </rule>
            <rule>
                <name>搜索半径</name>
                <value>3</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>角度阈值</name>
                <value>10</value>
                <unit>度</unit>
            </rule>
            <rule>
                <name>符号类型</name>
                <value>桥梁</value>
            </rule>
            <rule>
                <name>关联图层</name>
                <value>在建高速铁路;高速铁路;普通铁路;在建高速公路;高速公路;快速路;国道;省道;县道;乡道;专用公路;连接道</value>
            </rule>
        </check_item>
        <!-- 质检项3：标准图例匹配检查（ID:304） -->
        <check_item>
            <name>标准图例匹配检查</name>
            <id>304</id>
            <severity>高</severity>
            <rule>
                <name>标准图例匹配检查</name>
                <description>图层与标准图例是否一致</description>
                <value></value>
            </rule>
        </check_item>
    </scale>
</check_list>
