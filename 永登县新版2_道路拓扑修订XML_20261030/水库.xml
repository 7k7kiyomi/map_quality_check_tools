<?xml version="1.0" encoding="UTF-8"?>
<!--水库图层质检方案-->
<check_list>
    <scale>
        <value></value>
        <!-- 质检项1：要素层缺失检查（ID:101） -->
        <check_item>
            <name>要素层缺失检查</name>
            <id>101</id>
            <severity>高</severity>
            <rule>
                <name>缓冲区半径</name>
                <description>要素层缺失检查中库体数据缓冲区半径</description>
                <value>3</value>
                <unit>mm</unit>
            </rule>
        </check_item>
        <!-- 质检项2：要素缺失检查（ID:102） -->
        <check_item>
            <name>要素缺失检查</name>
            <id>102</id>
            <severity>低</severity>
            <rule>
                <name>属性项</name>
                <description>库体数据中区分水库的属性项</description>
                <value>CLASID</value>
                <unit></unit>
            </rule>
            <rule>
                <name>属性值</name>
                <description>属性项对水库的属性值</description>
                <value>240101</value>
                <unit></unit>
            </rule>
            <rule>
                <name>缓冲区半径</name>
                <description>建立缓冲区半径</description>
                <value>3</value>
                <unit>mm</unit>
            </rule>
            <rule>
                <name>最小面积</name>
                <description>选择表示的最小面积</description>
                <value>4</value>
                <unit>平方毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项3：符号方向性检查（ID:209） -->
        <check_item>
            <id>209</id>
            <severity>高</severity>
            <name>符号方向性检查</name>
            <rule>
                <name>符号类型</name>
                <value>点状水库</value>
            </rule>
            <rule>
                <name>关联图层</name>
                <value>一级河流;二级河流;三级河流;四级河流;五级河流;六级河流;等外河流</value>
            </rule>
            <rule>
                <name>检查类型</name>
                <value>方向一致</value>
            </rule>
            <rule>
                <name>搜索半径</name>
                <unit>毫米</unit>
                <value>8</value>
            </rule>
            <rule>
                <name>角度阈值</name>
                <unit>度</unit>
                <value>15</value>
            </rule>
        </check_item>
    </scale>
</check_list>