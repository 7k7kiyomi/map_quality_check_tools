<?xml version="1.0" encoding="UTF-8"?>
<!--湖泊水库面图层质检方案-->
<check_list>
    <scale>
        <value></value>
        <!-- 质检项1：要素层缺失检查（ID:101） -->
        <check_item>
            <name>要素层缺失检查</name>
            <id>101</id>
            <severity>高</severity>
            <rule>
                <name>缓冲区半径</name>
                <description>要素层缺失检查中库体数据缓冲区半径</description>
                <value>3</value>
                <unit>mm</unit>
            </rule>
        </check_item>
        <!-- 质检项2：要素缺失检查（ID:102） -->
        <check_item>
            <name>要素缺失检查</name>
            <id>102</id>
            <severity>高</severity>
            <rule>
                <name>属性项</name>
                <description>库体数据中区分湖泊水库面的属性项</description>
                <value></value>
                <unit></unit>
            </rule>
            <rule>
                <name>属性值</name>
                <description>属性项对湖泊水库的属性值</description>
                <value></value>
                <unit></unit>
            </rule>
            <rule>
                <name>缓冲区半径</name>
                <description>建立缓冲区半径</description>
                <value>3</value>
                <unit>mm</unit>
            </rule>
            <rule>
                <name>最小面积</name>
                <description>选择表示的最小面积</description>
                <value>6</value>
                <unit>平方毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项3：要素错绘检查（ID:103） -->
        <check_item>
            <name>要素错绘检查</name>
            <id>103</id>
            <severity>高</severity>
            <rule>
                <name>缓冲区半径</name>
                <description>库体数据缓冲区半径</description>
                <value>3</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项4：绝对偏移检查（ID:104） -->
        <check_item>
            <name>绝对偏移检查</name>
            <id>104</id>
            <severity>高</severity>
            <rule>
                <name>缓冲区半径</name>
                <description>库体数据缓冲区半径</description>
                <!-- 0.2（河流宽度一半）+0.3 -->
                <value>4.35</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项5：最小弯曲阈值控制（ID:106） -->
        <check_item>
            <name>最小弯曲阈值控制</name>
            <id>106</id>
            <severity>中</severity>
            <rule>
                <name>斜率判断阈值</name>
                <description>斜率变化角度（转折角），超过则认为是拐点</description>
                <value>10</value>
                <unit>度</unit>
            </rule>
            <rule>
                <name>最小弯曲阈值</name>
                <description>小于最小弯曲阈值的弯曲在综合时应被简化</description>
                <value>4</value>
                <unit>平方毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项6：特征点限差控制（ID:107） -->
        <check_item>
            <name>特征点限差控制</name>
            <id>107</id>
            <severity>高</severity>
            <rule>
                <name>特征点限差控制阈值</name>
                <description>库体数据点和综合后数据点间可接受的距离</description>
                <value>4</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项7：光滑度阈值控制（ID:108） -->
        <check_item>
            <id>108</id>
            <severity>低</severity>
            <name>光滑度阈值控制</name>
            <rule>
                <name>光滑度阈值</name>
                <description>综合后图上光滑度阈值</description>
                <value>0.36</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项8：削尖角度阈值控制（ID:110） -->
        <check_item>
            <name>削尖角度阈值控制</name>
            <id>110</id>
            <severity>低</severity>
            <rule>
                <name>削尖角度阈值</name>
                <description>检测线状、面状要素中小于该值的尖角需要剔除</description>
                <value>20</value>
                <unit>度</unit>
            </rule>
        </check_item>
    </scale>
</check_list>