<?xml version="1.0" encoding="UTF-8"?>
<check_list>
    <scale>
        <value></value>
        <!-- 质检项1：注记匹配（ID:200） -->
        <check_item>
            <name>注记匹配</name>
            <id>200</id>
            <severity>高</severity>
            <rule>
                <name>属性项</name>
                <description>GDB数据分层属性</description>
                <value>CLASID</value>
            </rule>
            <rule>
                <name>属性值</name>
                <description>GDB数据分层属性值</description>
                <value>319012</value>
            </rule>
            <rule>
                <name>标注字段</name>
                <description>GDB数据对应注记内容的属性</description>
                <value>NAMES</value>
            </rule>
        </check_item>
        <!-- 质检项2：字体（ID:201） -->
        <check_item>
            <name>字体</name>
            <id>201</id>
            <severity>高</severity>
            <rule>
                <name>字体名</name>
                <description>字体中文名</description>
                <value>方正仿宋</value>
            </rule>
        </check_item>
        <!-- 质检项3：字大（ID:202） -->
        <check_item>
            <name>字大</name>
            <id>202</id>
            <severity>高</severity>
            <rule>
                <name>字体大小</name>
                <description>字体大小</description>
                <value>2.5</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项4：字体颜色（ID:203） -->
        <check_item>
            <name>字体颜色</name>
            <id>203</id>
            <severity>高</severity>
            <rule>
                <name>颜色代码</name>
                <description>字体颜色代码</description>
                <value>K100</value>
            </rule>
        </check_item>
        <!-- 质检项5：字距（ID:204） -->
        <check_item>
            <name>字距</name>
            <id>204</id>
            <severity>中</severity>
            <rule>
                <name>字体最小间距</name>
                <description>单个字体间最小允许间距</description>
                <value>1</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>字体最大间距</name>
                <description>单个字体间最大允许间距</description>
                <value>5</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项6：符号注记匹配（ID:210） -->
        <check_item>
            <name>符号注记匹配</name>
            <id>210</id>
            <severity>高</severity>
            <rule>
                <name>允许无注记</name>
                <description>是否允许符号没有对应的注记</description>
                <value>false</value>
            </rule>
            <rule>
                <name>允许无符号</name>
                <description>是否允许注记没有对应的符号</description>
                <value>false</value>
            </rule>
            <rule>
                <name>最小间距</name>
                <description>匹配的符号与注记之间的最小允许间距</description>
                <value>2</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>最大间距</name>
                <description>匹配的符号与注记之间的最大允许间距</description>
                <value>5</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项7：敏感文字合规性检查（ID:212） -->
        <check_item>
            <name>敏感文字合规性检查</name>
            <id>212</id>
            <severity>高</severity>
            <rule>
                <name>安全</name>
                <description>安全相关敏感词列表</description>
                <value>公安,特警,刑事侦查,刑侦,安全厅,安全局,核安全局,保密局,机要局,核,国防,人防</value>
            </rule>
            <rule>
                <name>涉军</name>
                <description>涉军相关敏感词列表</description>
                <value>解放军,部队,陆军,后勤部,指挥部,武装部,军区,军队,军供站,军休,军人,军事,空军,训练场,联勤保障,战备,武警,民兵,军粮,军事管理区,军事禁区,军警民,军用,休养所,干休所,干部休养所</value>
            </rule>
            <rule>
                <name>卫星导航定位</name>
                <description>卫星导航定位相关敏感词列表</description>
                <value>卫星导航,CORS,基准站,大地控制点,卫星跟踪站,导航台,航天,野外观测站</value>
            </rule>
            <rule>
                <name>监测通讯</name>
                <description>监测通讯相关敏感词列表</description>
                <value>发射台,雷达站,地震,气象,观测站,监测站,监测台,气候站,监测点,微波台,转播,通信</value>
            </rule>
            <rule>
                <name>供水水利</name>
                <description>供水、水利相关敏感词列表</description>
                <value>水库,大坝,水利,井室,井房,泵房,水电站,节水,排水,水管站,饮水管理,泵,自来水,地下水,水务集团,水厂,水利枢纽,水文站,饮水安全工程,污水,供水,水利站,水利管理,饮水工程,饮水供应站,饮用水水库,泄洪桥,供水站,堤灌站,堤灌,泵站</value>
            </rule>
            <rule>
                <name>能源电力</name>
                <description>能源、电力相关敏感词列表</description>
                <value>电波,电力,供电,热电,变电站,火电,电灌,送变电工程,国家电网,国家国网,110kV,110千伏,35KV,升压站,变电所,送电,阀站,供气站,供热,热源,LNG,太阳能,发电,电站,阀室,发电基地,国家管网,石油,液化气站,液化石油气站,加气站,气化站,燃气调压站,输气管道,天然气,充电站,热力,供热站,加注站</value>
            </rule>
            <rule>
                <name>矿井</name>
                <description>矿井相关敏感词列表</description>
                <value>斜井,井矿,矿井,煤矿</value>
            </rule>
            <rule>
                <name>粮食仓储</name>
                <description>粮食仓储相关敏感词列表</description>
                <value>粮管,粮库,粮站,粮食</value>
            </rule>
            <rule>
                <name>危险品储运</name>
                <description>危险品储运相关敏感词列表</description>
                <value>能源站,制气站,制汽站,液化,加油站,成品油</value>
            </rule>
            <rule>
                <name>羁押场所</name>
                <description>羁押场所相关敏感词列表</description>
                <value>监狱,劳改所,戒毒所,拘留所,看守所,未成年犯管教所,教育矫治所</value>
            </rule>
            <rule>
                <name>其他</name>
                <description>其他类敏感词列表</description>
                <value>专用线,实验,物资储备,仓库,仓储,基地,仓储基地,仓储中心,保密技术服务中心</value>
            </rule>
        </check_item>
        <!-- 质检项8：注记内容合规性（ID:213） -->
        <check_item>
            <name>注记内容合规性</name>
            <id>213</id>
            <severity>中</severity>
            <rule>
                <name>最小间距</name>
                <description>注记点位到所关联源要素图形的最短距离下限（点注记取坐标点，线/面注记取几何质心）</description>
                <value>0.1</value>
                <unit>mm</unit>
            </rule>
            <rule>
                <name>最大间距</name>
                <description>注记点位到所关联源要素图形的最短距离上限（点注记取坐标点，线/面注记取几何质心）</description>
                <value>4</value>
                <unit>mm</unit>
            </rule>
        </check_item>
    </scale>
</check_list>
