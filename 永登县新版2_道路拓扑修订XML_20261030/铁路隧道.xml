<?xml version="1.0" encoding="UTF-8"?>
<!--铁路隧道图层质检方案-->
<check_list>
    <scale>
        <value></value>
        <!-- 质检项1：要素层缺失检查（ID:101） -->
        <check_item>
            <name>要素层缺失检查</name>
            <id>101</id>
            <severity>高</severity>
            <rule>
                <name>缓冲区半径</name>
                <description>要素层缺失检查中库体数据缓冲区半径</description>
                <value>3</value>
                <unit>mm</unit>
            </rule>
        </check_item>
        <!-- 质检项2：要素缺失检查（ID:102） -->
        <check_item>
            <name>要素缺失检查</name>
            <id>102</id>
            <severity>高</severity>
            <rule>
                <name>属性项</name>
                <description>库体数据中区分铁路隧道的属性项</description>
                <value>CLASID</value>
            </rule>
            <rule>
                <name>属性值</name>
                <description>属性项对铁路隧道的属性值</description>
                <value>450601</value>
            </rule>
            <rule>
                <name>缓冲区半径</name>
                <description>建立缓冲区半径</description>
                <value>3</value>
                <unit>mm</unit>
            </rule>
            <rule>
                <name>最小长度</name>
                <description>选择表示的最小长度</description>
                <value>1</value>
                <unit>cm</unit>
            </rule>
        </check_item>
        <!-- 质检项3：要素错绘检查（ID:103） -->
        <check_item>
            <name>要素错绘检查</name>
            <id>103</id>
            <severity>高</severity>
            <rule>
                <name>缓冲区半径</name>
                <description>库体数据缓冲区半径</description>
                <value>3</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项4：绝对偏移检查（ID:104） -->
        <check_item>
            <name>绝对偏移检查</name>
            <id>104</id>
            <severity>高</severity>
            <rule>
                <name>缓冲区半径</name>
                <description>库体数据缓冲区半径</description>
                <value>4.35</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项5：特征点限差控制（ID:107） -->
        <check_item>
            <name>特征点限差控制</name>
            <id>107</id>
            <severity>高</severity>
            <rule>
                <name>特征点限差控制阈值</name>
                <description>库体数据点和综合后数据点间可接受的距离</description>
                <value>4</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项6：削尖角度阈值控制（ID:110） -->
        <check_item>
            <name>削尖角度阈值控制</name>
            <id>110</id>
            <severity>中</severity>
            <rule>
                <name>削尖角度阈值</name>
                <description>检测线状、面状要素中小于该值的尖角需要剔除</description>
                <value>20</value>
                <unit>度</unit>
            </rule>
        </check_item>
        <!-- 质检项7：线要素拓扑检查（ID:112） -->
        <check_item>
            <name>线要素拓扑检查</name>
            <id>112</id>
            <severity>中</severity>
            <rule>
                <name>关联图层</name>
                <description>水系、道路线要素与那些图层关联，检查方向性</description>
                <value>湖泊水库面、河流面、水库、拦河坝、井、泉</value>
            </rule>
            <rule>
                <name>悬挂线容差</name>
                <description>悬挂线检查的容差距离</description>
                <value>0.003</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>最小线段长度</name>
                <description>线要素的最小有效长度</description>
                <value>0.034</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>孤立距离</name>
                <description>判定线要素孤立的距离阈值</description>
                <value>0.069</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>连通性容差</name>
                <description>线要素连通性检查的容差</description>
                <value>0.034</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>网络缓冲距离</name>
                <description>网络连通性分析的缓冲距离</description>
                <value>0.014</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>连通性阈值</name>
                <description>网络连通性的百分比阈值</description>
                <value>95</value>
                <unit>百分比</unit>
            </rule>
            <rule>
                <name>库体数据匹配容差</name>
                <description>与库体数据进行空间关系对比的容差距离</description>
                <value>0.006897</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
    </scale>
</check_list>
