<?xml version="1.0" encoding="UTF-8"?>
<check_list>
    <scale>
        <value></value>
        <!-- 质检项1：注记匹配（ID:200） -->
        <check_item>
            <name>注记匹配</name>
            <id>200</id>
            <severity>高</severity>
            <rule>
                <name>属性项</name>
                <description>GDB数据分层属性</description>
                <value>CLASID</value>
            </rule>
            <rule>
                <name>属性值</name>
                <description>GDB数据分层属性值</description>
                <value>420901</value>
            </rule>
            <rule>
                <name>标注字段</name>
                <description>GDB数据对应注记内容的属性</description>
                <value>RN</value>
            </rule>
        </check_item>
        <!-- 质检项2：字体（ID:201） -->
        <check_item>
            <name>字体</name>
            <id>201</id>
            <severity>高</severity>
            <rule>
                <name>字体名</name>
                <description>字体中文名</description>
                <value>仿宋GB2312</value>
            </rule>
        </check_item>
        <!-- 质检项3：字大（ID:202） -->
        <check_item>
            <name>字大</name>
            <id>202</id>
            <severity>高</severity>
            <rule>
                <name>字体大小</name>
                <description>字体大小</description>
                <value>2.25</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项4：字体颜色（ID:203） -->
        <check_item>
            <name>字体颜色</name>
            <id>203</id>
            <severity>高</severity>
            <rule>
                <name>颜色代码</name>
                <description>字体颜色代码</description>
                <value>M100Y100</value>
            </rule>
        </check_item>
        <!-- 质检项5：字距（ID:204） -->
        <check_item>
            <name>字距</name>
            <id>204</id>
            <severity>中</severity>
            <rule>
                <name>字体最小间距</name>
                <description>单个字体间最尋允许间距</description>
                <value>1</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>字体最大间距</name>
                <description>单个字体间最大允许间距</description>
                <value>5</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
        <!-- 质检项6：符号方向性检查（ID:209） -->
        <check_item>
            <name>符号方向性检查</name>
            <id>209</id>
            <severity>高</severity>
            <rule>
                <name>符号类型</name>
                <value>道路代码</value>
            </rule>
            <rule>
                <name>关联图层</name>
                <value>高速公路</value>
            </rule>
            <rule>
                <name>检查类型</name>
                <value>平行</value>
            </rule>
            <rule>
                <name>搜索半径</name>
                <value>3</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>角度阈值</name>
                <value>15</value>
                <unit>度</unit>
            </rule>
        </check_item>
        <!-- 质检项7：注记内容合规性（ID:213） -->
        <check_item>
            <name>注记内容合规性</name>
            <id>213</id>
            <severity>高</severity>
            <rule>
                <name>最小间距</name>
                <description>注记点位到所关联源要素图形的最短距离下限（点注记取坐标点，线/面注记取几何质心）</description>
                <value>2</value>
                <unit>mm</unit>
            </rule>
            <rule>
                <name>最大间距</name>
                <description>注记点位到所关联源要素图形的最短距离上限（点注记取坐标点，线/面注记取几何质心）</description>
                <value>20</value>
                <unit>mm</unit>
            </rule>
        </check_item>
    </scale>
</check_list>
