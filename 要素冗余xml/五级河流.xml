<?xml version="1.0" encoding="UTF-8"?>
<!-- 五级河流要素冗余检查规则；ID=119；配合要素冗余检查算法使用。 -->
<check_list>
    <scale>
        <value></value>
        <check_item>
            <name>要素冗余检查</name>
            <id>119</id>
            <severity>高</severity>
            <rule>
                <name>检查类型</name>
                <description></description>
                <value>河流</value>
                <unit></unit>
            </rule>
            <rule>
                <name>检查图层</name>
                <description>从混合成果中匹配类别，不要求存在干涸河.shp</description>
                <value>水系</value>
                <unit></unit>
            </rule>
            <rule>
                <name>参考GDB图层</name>
                <description>补全成果缺失属性，并提供一至五级完整必表清单；参考几何仅用于匹配、范围与缺失定位</description>
                <value>HYDL_HL</value>
                <unit></unit>
            </rule>
            <rule><name>属性候选筛选条件</name><description>缺少LEVEL时匹配完整河网；已有有效LEVEL时由算法约束候选等级</description><value></value><unit></unit></rule>
            <rule><name>必表清单筛选条件</name><description>HYDL_HL完整清单一至五级；各等级任务负责本级；外区干涸河例外优先</description><value>LEVEL IN ('一级','二级','三级','四级','五级')</value><unit></unit></rule>
            <rule>
                <name>子类分流</name>
                <description>按LEVEL归入六级，包含TYPE为干涸河的记录，并追加外区禁表；不需要独立干涸河任务</description>
                <value>按等级包含干涸河</value>
                <unit></unit>
            </rule>
            <rule><name>任务目标资格</name><description>每个等级任务负责自身等级的实际成果和必表清单，避免重复</description><value>五级</value><unit></unit></rule>
            <rule>
                <name>等级字段</name>
                <description></description>
                <value>LEVEL</value>
                <unit></unit>
            </rule>
            <rule>
                <name>类型字段</name>
                <description></description>
                <value>TYPE</value>
                <unit></unit>
            </rule>
            <rule>
                <name>名称字段</name>
                <description></description>
                <value>NAME</value>
                <unit></unit>
            </rule>
            <rule>
                <name>河流业务标识字段</name>
                <description>仅组织GDB属性匹配候选，优先WRID并校核名称、等级、类型和拓扑；不用于拼接成果几何</description>
                <value>WRID</value>
                <unit></unit>
            </rule>
            <rule>
                <name>干涸河属性值</name>
                <description></description>
                <value>干涸河</value>
                <unit></unit>
            </rule>
            <rule>
                <name>规则优先级</name>
                <description></description>
                <value>主区外干涸河禁止 &gt; 一至五级必须表示 &gt; 六级等外长度与间距</value>
                <unit></unit>
            </rule>
            <rule>
                <name>全部表示等级</name>
                <description>一至五级必须表示；确认未表示输出missing并单列缺失计数</description>
                <value>一级;二级;三级;四级;五级</value>
                <unit></unit>
            </rule>
            <rule>
                <name>选取表示等级</name>
                <description></description>
                <value>六级;等外</value>
                <unit></unit>
            </rule>
            <rule>
                <name>长度计算依据</name>
                <description>仅按成果自身可靠symbol_id或业务标识归组；无可靠身份的独立成果几何分别量测；GDB标识不参与成果组装，不使用LEN占位值</description>
                <value>解析成果SHP河流在检查范围内的实际几何长度</value>
                <unit></unit>
            </rule>
            <rule>
                <name>最小选取长度</name>
                <description>六级和等外长度严格大于门槛才满足条件</description>
                <value>15</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>最小选取长度比较符</name>
                <description></description>
                <value>&gt;</value>
                <unit></unit>
            </rule>
            <rule>
                <name>选取参考最小间距</name>
                <description>低于此值直接报告选取过密冲突；正常汇流连接除外</description>
                <value>5</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>选取参考最大间距</name>
                <description>选取参考上界；大于此值不直接判冗余</description>
                <value>10</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>间距检查方式</name>
                <description>用户已确认；排除正常共享汇流点的零距离</description>
                <value>相邻独立河流的图上空间间距</value>
                <unit></unit>
            </rule>
            <rule>
                <name>间距冲突处理</name>
                <description>不能把冲突中的全部河流都认定为错误</description>
                <value>自动报告选取过密冲突</value>
                <unit></unit>
            </rule>
            <rule>
                <name>主区判定来源</name>
                <description>以成果主区普色面确定本图主区</description>
                <value>成果普色面</value>
                <unit></unit>
            </rule>
            <rule>
                <name>主区范围图层</name>
                <description>合并全部主区普色面，不按颜色筛选，保留有效孔洞和多部件</description>
                <value>行政区划面普色</value>
                <unit></unit>
            </rule>
            <rule>
                <name>主区构建方式</name>
                <description>合并后作为主区；检查对象另按内图廓限定检查范围</description>
                <value>全部主区普色面合并</value>
                <unit></unit>
            </rule>
            <rule>
                <name>主区无效几何处理</name>
                <description>记录修复对象及结果，不修改源SHP；无法可靠恢复时不自动判错</description>
                <value>仅在内存中验证修复；失败则无法判定</value>
                <unit></unit>
            </rule>
            <rule>
                <name>主区校核GDB图层</name>
                <description>可选辅助校核；不以行政面替换或裁切成果主区</description>
                <value>BOUA5</value>
                <unit></unit>
            </rule>
            <rule>
                <name>主区校核筛选条件</name>
                <description>仅为永登县辅助校核示例，其他地图按任务配置</description>
                <value>PAC = '620121000000'</value>
                <unit></unit>
            </rule>
            <rule>
                <name>检查范围图层</name>
                <description></description>
                <value>内图廓</value>
                <unit></unit>
            </rule>
            <rule>
                <name>外区范围图层</name>
                <description>读取背景范围，扣除主区后得到实际外区；缺失不静默换用其他范围</description>
                <value>外区普色</value>
                <unit></unit>
            </rule>
            <rule>
                <name>外区判定方式</name>
                <description>保留有效孔洞及多部件；几何先验证，必要时仅在内存修复</description>
                <value>外区普色合并面减主区普色合并面</value>
                <unit></unit>
            </rule>
            <rule>
                <name>主区边界容差</name>
                <description>建议初值；边界复核带内不自动判主区外冗余</description>
                <value>0.2</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>主区外干涸河是否允许表示</name>
                <description></description>
                <value>false</value>
                <unit></unit>
            </rule>
            <rule>
                <name>跨主区边界处理</name>
                <description>不因部分跨界将整条河流判错</description>
                <value>仅检查确认处于外区的已表示干涸河区段</value>
                <unit></unit>
            </rule>
            <rule>
                <name>河流注记图层</name>
                <description></description>
                <value>水系_标注</value>
                <unit></unit>
            </rule>
            <rule>
                <name>注记读取方式</name>
                <description></description>
                <value>复用现有注记提取与匹配</value>
                <unit></unit>
            </rule>
            <rule>
                <name>注记允许的最末等级</name>
                <description>等外河流名称注记属于超范围；未知等级人工复核</description>
                <value>六级</value>
                <unit></unit>
            </rule>
            <rule>
                <name>六级名称必注长度</name>
                <description>达到此长度必须有名称；完整可读注记成果确认缺少时输出annotation_missing</description>
                <value>30</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>六级名称必注长度比较符</name>
                <description></description>
                <value>&gt;=</value>
                <unit></unit>
            </rule>
            <rule>
                <name>不足必注长度是否禁止六级名称</name>
                <description>达到门槛应注名并不等于较短六级河流一律禁止注名</description>
                <value>false</value>
                <unit></unit>
            </rule>
            <rule>
                <name>缺少必需名称处理</name>
                <description></description>
                <value>完整可靠输入确认缺少则输出annotation_missing；不可读或歧义诊断</value>
                <unit></unit>
            </rule>
            <rule>
                <name>检查范围</name>
                <description>同时核对禁止表示与完整必表清单，确认缺失为正式错误</description>
                <value>已表示资格与必表缺失双向核对</value>
                <unit></unit>
            </rule>
            <rule>
                <name>候选匹配搜索半径</name>
                <description>建议初值，须据数据校准；不得放宽业务阈值</description>
                <value>2</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>匹配不确定处理</name>
                <description>匹配不唯一、属性未知、输入不完整时不自动判错</description>
                <value>人工复核</value>
                <unit></unit>
            </rule>
            <rule>
                <name>比例尺来源</name>
                <description>scale/value 空值表示通用规则</description>
                <value>当前质检任务</value>
                <unit></unit>
            </rule>
        <rule><name>选取参考最小间距比较符</name><description>允许的成果河流最小间距比较符</description><value>&gt;=</value><unit></unit></rule>
        </check_item>
    </scale>
</check_list>
