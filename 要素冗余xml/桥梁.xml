<?xml version="1.0" encoding="UTF-8"?>
<!-- 桥梁要素冗余检查规则；ID=119；配合要素冗余检查算法使用。 -->
<check_list>
    <scale>
        <value></value>
        <check_item>
            <name>要素冗余检查</name>
            <id>119</id>
            <severity>高</severity>
            <rule>
                <name>检查类型</name>
                <description></description>
                <value>桥梁</value>
                <unit></unit>
            </rule>
            <rule>
                <name>检查图层</name>
                <description></description>
                <value>桥梁</value>
                <unit></unit>
            </rule>
            <rule>
                <name>桥梁成果分组字段</name>
                <description>当前201条绘制路径属于67个桥梁符号</description>
                <value>symbol_id</value>
                <unit></unit>
            </rule>
            <rule>
                <name>桥梁类别字段</name>
                <description></description>
                <value>symbol_nam</value>
                <unit></unit>
            </rule>
            <rule>
                <name>公路桥符号值</name>
                <description></description>
                <value>公路桥</value>
                <unit></unit>
            </rule>
            <rule>
                <name>铁路桥符号值</name>
                <description></description>
                <value>铁路桥</value>
                <unit></unit>
            </rule>
            <rule>
                <name>公路载体GDB图层</name>
                <description></description>
                <value>LRDL</value>
                <unit></unit>
            </rule>
            <rule>
                <name>铁路载体GDB图层</name>
                <description></description>
                <value>LRRL</value>
                <unit></unit>
            </rule>
            <rule>
                <name>关联公路成果图层</name>
                <description></description>
                <value>高速公路;快速路;国道;省道;县道;乡道;专用公路;连接道;村道</value>
                <unit></unit>
            </rule>
            <rule>
                <name>关联铁路成果图层</name>
                <description></description>
                <value>高速铁路;普通铁路</value>
                <unit></unit>
            </rule>
            <rule>
                <name>水体面成果图层</name>
                <description>含河流面和湖泊水库面，保留孔洞</description>
                <value>水系面</value>
                <unit></unit>
            </rule>
            <rule>
                <name>水体面参考GDB图层</name>
                <description></description>
                <value>HYDA;HYDA_HPSK</value>
                <unit></unit>
            </rule>
            <rule>
                <name>跨水判定方式</name>
                <description>面内部存在正长度交段并具备穿越证据；相切、沿岸重合不算跨水</description>
                <value>道路进入并穿过有效水体面内部</value>
                <unit></unit>
            </rule>
            <rule>
                <name>道路断绘处理</name>
                <description>桥符号遮白造成断线不直接判没有道路</description>
                <value>结合GDB载体恢复桥位处的道路连续关系</value>
                <unit></unit>
            </rule>
            <rule>
                <name>桥梁匹配对象</name>
                <description>桥符号包围盒碰到水面不是充分条件</description>
                <value>载体道路上的跨水位置</value>
                <unit></unit>
            </rule>
            <rule>
                <name>是否仅允许跨面水系桥梁</name>
                <description>当前规范只给出应表示条件；明确只允许跨水桥后可改true</description>
                <value>false</value>
                <unit></unit>
            </rule>
            <rule>
                <name>未跨水体面桥梁处理</name>
                <description>现有规则不能自动排除跨线桥、旱桥等</description>
                <value>疑似冗余，人工复核</value>
                <unit></unit>
            </rule>
            <rule>
                <name>应跨水但未表示桥梁处理</name>
                <description></description>
                <value>转要素缺失检查</value>
                <unit></unit>
            </rule>
            <rule>
                <name>关联道路或水体面缺失处理</name>
                <description></description>
                <value>输入或匹配异常，不直接判桥梁冗余</value>
                <unit></unit>
            </rule>
            <rule>
                <name>检查范围</name>
                <description>应表未表、必需名称缺失转对应检查</description>
                <value>仅检查已表示且明确不应表示的对象</value>
                <unit></unit>
            </rule>
            <rule>
                <name>候选匹配搜索半径</name>
                <description>建议初值，须据数据校准；不得放宽业务阈值</description>
                <value>2</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>匹配不确定处理</name>
                <description>匹配不唯一、属性未知、输入不完整时不自动判错</description>
                <value>人工复核</value>
                <unit></unit>
            </rule>
            <rule>
                <name>比例尺来源</name>
                <description>scale/value 空值表示通用规则</description>
                <value>当前质检任务</value>
                <unit></unit>
            </rule>
        </check_item>
    </scale>
</check_list>

