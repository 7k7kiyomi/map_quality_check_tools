<?xml version="1.0" encoding="UTF-8"?>
<!-- 火车站要素冗余检查规则；ID=119；配合要素冗余检查算法使用。 -->
<check_list>
    <scale>
        <value></value>
        <check_item>
            <name>要素冗余检查</name>
            <id>119</id>
            <severity>高</severity>
            <rule>
                <name>检查类型</name>
                <description></description>
                <value>火车站</value>
                <unit></unit>
            </rule>
            <rule>
                <name>检查图层</name>
                <description></description>
                <value>火车站</value>
                <unit></unit>
            </rule>
            <rule>
                <name>参考GDB图层</name>
                <description></description>
                <value>LRRP</value>
                <unit></unit>
            </rule>
            <rule>
                <name>属性候选筛选条件</name>
                <description></description>
                <value>CLASID = '410301'</value>
                <unit></unit>
            </rule>
            <rule>
                <name>成果分组字段</name>
                <description></description>
                <value>symbol_id</value>
                <unit></unit>
            </rule>
            <rule>
                <name>成果符号核对字段</name>
                <description>仅辅助核对符号类型，不替代GDB的CZFJ分类</description>
                <value>symbol_nam</value>
                <unit></unit>
            </rule>
            <rule>
                <name>普通车站符号值</name>
                <description></description>
                <value>普通火车站</value>
                <unit></unit>
            </rule>
            <rule>
                <name>高铁车站符号值</name>
                <description></description>
                <value>高铁火车站</value>
                <unit></unit>
            </rule>
            <rule>
                <name>城镇类别来源</name>
                <description>不凭最近驻地点推断所属城镇</description>
                <value>匹配LRRP的TYPE字段</value>
                <unit></unit>
            </rule>
            <rule>
                <name>城镇类别字段</name>
                <description></description>
                <value>TYPE</value>
                <unit></unit>
            </rule>
            <rule>
                <name>允许表示城镇类别</name>
                <description>当前已见允许值；县级以上其他字典值需扩展</description>
                <value>县级城市</value>
                <unit></unit>
            </rule>
            <rule>
                <name>禁止表示城镇类别</name>
                <description></description>
                <value>县级以下城镇</value>
                <unit></unit>
            </rule>
            <rule>
                <name>禁止表示对象</name>
                <description></description>
                <value>(CZFJ = 2 OR CZFJ = 3) AND TYPE = '县级以下城镇'</value>
                <unit></unit>
            </rule>
            <rule>
                <name>其他城镇类别处理</name>
                <description></description>
                <value>核对级别字典后判断，当前人工复核</value>
                <unit></unit>
            </rule>
            <rule>
                <name>高铁车站处理</name>
                <description>CZFJ=1，不受TYPE城镇类别限制，也不按主区外区限制</description>
                <value>全部表示；已有表示不计冗余</value>
                <unit></unit>
            </rule>
            <rule>
                <name>辅助核对GDB图层</name>
                <description></description>
                <value>BOUP6;BOUA5</value>
                <unit></unit>
            </rule>
            <rule>
                <name>辅助行政关联字段</name>
                <description></description>
                <value>CITYNAME</value>
                <unit></unit>
            </rule>
            <rule>
                <name>车站等级字段</name>
                <description></description>
                <value>CZFJ</value>
                <unit></unit>
            </rule>
            <rule>
                <name>车站分类来源</name>
                <description>用户已明确1为高铁，2和3为普通车站；不推断4的含义</description>
                <value>匹配LRRP的CZFJ字段</value>
                <unit></unit>
            </rule>
            <rule>
                <name>普通车站等级值</name>
                <description>多个值之间为或；与禁止表示城镇类别之间为且</description>
                <value>2;3</value>
                <unit></unit>
            </rule>
            <rule>
                <name>高铁车站等级值</name>
                <description></description>
                <value>1</value>
                <unit></unit>
            </rule>
            <rule>
                <name>车站属性标准化</name>
                <description>统一数值与文本编码，去除首尾空格；空值及无效占位值不转成合法类别</description>
                <value>按字段类型标准化CZFJ和TYPE</value>
                <unit></unit>
            </rule>
            <rule>
                <name>未定义车站等级处理</name>
                <description>CZFJ=4、空值及其他未定义值，不自动判冗余或通过</description>
                <value>人工复核</value>
                <unit></unit>
            </rule>
            <rule>
                <name>成果符号与GDB类别冲突处理</name>
                <description>表示资格按GDB属性判断；符号名称冲突另列符号类型异常，不掩盖已确认的禁表错误</description>
                <value>保留资格判断并输出符号类型复核</value>
                <unit></unit>
            </rule>
            <rule>
                <name>车站未表示处理</name>
                <description>高铁全部表示及普通站应表未表属于完整性，不计本项冗余错误</description>
                <value>在输入与匹配完整时确认完整清单缺失则输出missing</value>
                <unit></unit>
            </rule>
            <rule>
                <name>规则优先级</name>
                <description>普通车站城镇属性缺失或未知时复核；高铁不依赖TYPE判断资格</description>
                <value>CZFJ=1全部允许 &gt; CZFJ为2或3且县级以下城镇禁表 &gt; 其他情况按明确字典或复核</value>
                <unit></unit>
            </rule>
            <rule>
                <name>检查范围</name>
                <description>应表未表、必需名称缺失转对应检查</description>
                <value>成果有效属性优先；CZFJ=1完整清单必须表示</value>
                <unit></unit>
            </rule>
            <rule>
                <name>候选匹配搜索半径</name>
                <description>建议初值，须据数据校准；不得放宽业务阈值</description>
                <value>2</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>匹配不确定处理</name>
                <description>匹配不唯一、属性未知、输入不完整时不自动判错</description>
                <value>人工复核</value>
                <unit></unit>
            </rule>
            <rule>
                <name>比例尺来源</name>
                <description>scale/value 空值表示通用规则</description>
                <value>当前质检任务</value>
                <unit></unit>
            </rule>
        </check_item>
    </scale>
</check_list>

