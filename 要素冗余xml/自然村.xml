<?xml version="1.0" encoding="UTF-8"?>
<!-- 自然村要素冗余检查119；县图示例，市图需明确修改图种。 -->
<check_list>
    <scale>
        <value></value>
        <check_item>
            <name>要素冗余检查</name>
            <id>119</id>
            <severity>高</severity>
            <rule>
                <name>检查类型</name>
                <description></description>
                <value>村庄</value>
                <unit></unit>
            </rule>
            <rule>
                <name>检查对象</name>
                <description></description>
                <value>自然村</value>
                <unit></unit>
            </rule>
            <rule>
                <name>检查图层</name>
                <description></description>
                <value>自然村</value>
                <unit></unit>
            </rule>
            <rule>
                <name>参考GDB图层</name>
                <description></description>
                <value>BOUP8</value>
                <unit></unit>
            </rule>
            <rule>
                <name>图种</name>
                <description>县图示例；市图任务须明确改为市图，不能凭比例尺猜测。</description>
                <value>县图</value>
                <unit></unit>
            </rule>
            <rule>
                <name>成果分组字段</name>
                <description></description>
                <value>symbol_id</value>
                <unit></unit>
            </rule>
            <rule>
                <name>符号中心一致性容差</name>
                <description>从投影几何恢复同心符号定位点，不使用页面坐标 symbol_cen。</description>
                <value>0.1</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>候选匹配搜索半径</name>
                <description></description>
                <value>2</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>社区识别方式</name>
                <description></description>
                <value>名称后缀</value>
                <unit></unit>
            </rule>
            <rule>
                <name>社区类别字段</name>
                <description></description>
                <value>NAME</value>
                <unit></unit>
            </rule>
            <rule>
                <name>社区名称后缀</name>
                <description>用户确认的 NAME 后缀字典；空值或无法唯一匹配不得默认普通村庄。</description>
                <value>社区;社区居委会</value>
                <unit></unit>
            </rule>
            <rule>
                <name>检查范围图层</name>
                <description></description>
                <value>内图廓</value>
                <unit></unit>
            </rule>
            <rule>
                <name>主区范围图层</name>
                <description></description>
                <value>行政区划面普色</value>
                <unit></unit>
            </rule>
            <rule>
                <name>外区范围图层</name>
                <description></description>
                <value>外区普色</value>
                <unit></unit>
            </rule>
            <rule>
                <name>主外区边界归属</name>
                <description>主区普色合并；外区普色合并减主区。定位点在共享边界归主区。</description>
                <value>主区优先</value>
                <unit></unit>
            </rule>
            <rule>
                <name>密度基准图层</name>
                <description></description>
                <value>行政村</value>
                <unit></unit>
            </rule>
            <rule>
                <name>密度缓冲基准</name>
                <description></description>
                <value>成果行政村符号定位点</value>
                <unit></unit>
            </rule>
            <rule>
                <name>密度缓冲方式</name>
                <description></description>
                <value>定位点圆形缓冲</value>
                <unit></unit>
            </rule>
            <rule>
                <name>密集区缓冲半径</name>
                <description></description>
                <value>0.9</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>密集区最小面积</name>
                <description>缓冲融合后按独立连通面筛选；小于门槛剔除，等于保留。单点缓冲面也可能达到门槛，按原数值执行。</description>
                <value>2</value>
                <unit>平方毫米</unit>
            </rule>
            <rule>
                <name>一般密集区缓冲半径</name>
                <description></description>
                <value>1.7</value>
                <unit>毫米</unit>
            </rule>
            <rule>
                <name>一般密集区最小面积</name>
                <description>先融合并筛选，再减去密集区；扣除后不重复进行9平方毫米筛选。</description>
                <value>9</value>
                <unit>平方毫米</unit>
            </rule>
            <rule>
                <name>密度边界归属</name>
                <description></description>
                <value>密集区优先;一般密集区其次;稀疏区最后</value>
                <unit></unit>
            </rule>
            <rule>
                <name>密集区社区是否允许表示</name>
                <description>仅主区密集区中确认属于社区的对象禁表，不把所有密集区村庄都禁表。</description>
                <value>false</value>
                <unit></unit>
            </rule>
            <rule>
                <name>市图自然村是否允许表示</name>
                <description></description>
                <value>false</value>
                <unit></unit>
            </rule>
            <rule>
                <name>外区自然村是否允许表示</name>
                <description></description>
                <value>false</value>
                <unit></unit>
            </rule>
            <rule>
                <name>数量统计方式</name>
                <description>用户确认；检查任意平移的固定面积圆窗，通过成对点确定候选圆心，不能只以村庄为圆心。</description>
                <value>滑动圆窗</value>
                <unit></unit>
            </rule>
            <rule>
                <name>主区统计面积</name>
                <description></description>
                <value>2</value>
                <unit>平方厘米</unit>
            </rule>
            <rule>
                <name>主区数量上限</name>
                <description></description>
                <value>2</value>
                <unit></unit>
            </rule>
            <rule>
                <name>外区统计面积</name>
                <description>行政村外区数量规则；自然村外区直接禁表，不执行数量规则。</description>
                <value>2</value>
                <unit>平方厘米</unit>
            </rule>
            <rule>
                <name>外区数量上限</name>
                <description></description>
                <value>1</value>
                <unit></unit>
            </rule>
            <rule>
                <name>外区最小间距</name>
                <description>行政村外区定位点间距至少1厘米，等于门槛通过。</description>
                <value>10</value>
                <unit>毫米</unit>
            </rule>
        </check_item>
    </scale>
</check_list>
